# Discord application (Developer Portal → OAuth2)
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot token (Developer Portal → Bot → Reset Token). The bot posts with it, the command
# script registers commands with it, and the Activity uses it to verify players in DMs.
DISCORD_BOT_TOKEN=

# Developer Portal → General Information → Public Key. Checks that slash commands really come from Discord.
DISCORD_PUBLIC_KEY=

# Protects the daily-post job (/api/cron/daily). Vercel sends it automatically once it's set in the
# project. Generate with: openssl rand -base64 32
CRON_SECRET=

# Signs game sessions. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional: every first solve of a puzzle (not revealed) is POSTed here as JSON:
# {"game", "user_id", "date": "YYYY-MM-DD", "solve_time_secs", "points"}, for a bot or another service to keep.
# The token, if set, is sent as "Authorization: Bearer <token>". Leave the URL unset to send nothing.
RESULTS_WEBHOOK_URL=
RESULTS_WEBHOOK_TOKEN=

# Storage: set ONE of the two options below, or neither in development to use an in-memory store.

# 1. A regular Redis server, e.g. redis://:password@host:6379/1 (the path picks the database),
#    or rediss://... for TLS. The optional prefix is added to every key, e.g. "daily-grind:",
#    which lets a shared server limit this app to its own keys with a Redis ACL.
REDIS_URL=
REDIS_KEY_PREFIX=

# 2. Upstash Redis (Vercel's Upstash integration may set KV_REST_API_URL / KV_REST_API_TOKEN instead).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
