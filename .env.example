# Discord application (Developer Portal → OAuth2)
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: Bot token (Developer Portal -> Bot). Only needed for leaderboards when the
# Activity runs in a DM or group DM, to verify the player is really in that DM.
DISCORD_BOT_TOKEN=

# Signs game sessions. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Upstash Redis (Vercel's Upstash integration may set KV_REST_API_URL / KV_REST_API_TOKEN instead).
# Leave unset in development to use an in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
